@page "/projects"

@using Microsoft.EntityFrameworkCore
@using oedibud.Models
@using oedibud.Data
@inject IDbContextFactory<BudgetDbContext> DbFactory

<PageTitle>Projekte</PageTitle>

<h3 class="text-primary-emphasis">Projekte</h3>
<hr />

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

@if (projects.Count == 0)
{
    <p>Keine Projekte verfügbar.</p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titel</th>
            <th>Projektstart</th>
            <th>Projektende</th>
            <th>Gesamt</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in projects)
        {
            <tr>
                <td>@p.Id</td>
                @if (editingProjectId == p.Id)
                {
                    <td><input class="form-control" @bind="editProjectCopy.Title" /></td>
                    <td><input type="date" class="form-control" @bind="editProjectCopy.Start" /></td>
                    <td><input type="date" class="form-control" @bind="editProjectCopy.End" /></td>
                    <td>@p.TotalAmount.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-success me-2" @onclick="() => SaveProject(editProjectCopy.Id)">Speichern</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="CancelEditProject">Abbrechen</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleExpand(p.Id)">
                            @(expanded.Contains(p.Id) ? "Verstecken" : "Projektmittel verwalten")
                        </button>
                    </td>
                }
                else
                {
                    <td>@p.Title</td>
                    <td>@p.Start.ToShortDateString()</td>
                    <td>@p.End.ToShortDateString()</td>
                    <td>@p.TotalAmount.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditProject(p)">Bearbeiten</button>
                        <button class="btn btn-sm btn-danger me-2" @onclick="() => DeleteProject(p)">Löschen</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleExpand(p.Id)">
                            @(expanded.Contains(p.Id) ? "Verstecken" : "Projektmittel verwalten")
                        </button>
                    </td>
                }
            </tr>
            @if (expanded.Contains(p.Id))
            {
                <tr>
                    <td colspan="6" class="p-0 bg-dark-subtle">
                        <div class="p-3">
                            <PaymentTable
                                payments="p.Payments"
                                projects="projects"
                                contracts="@(new List<Contract>())"
                                FilterProjectId="p.Id"
                                ShowContractAssignments="false"
                                ShowAddForm="true"
                                Compact="true"
                                OnMessageChanged="m => { message = m; StateHasChanged(); }" />
                        </div>
                    </td>
                </tr>
            }
        }
        <tr>
            <td class="fst-italic text-muted">neu</td>
            <td><input class="form-control" placeholder="Titel" @bind="newProject.Title" /></td>
            <td><input type="date" class="form-control" @bind="newProject.Start" /></td>
            <td><input type="date" class="form-control" @bind="newProject.End" /></td>
            <td></td>
            <td>
                <button class="btn btn-sm btn-success" @onclick="AddProject">Hinzufügen</button>
            </td>
        </tr>
    </tbody>
</table>

@code {
    private List<Project> projects = new();
    private Project newProject = new()
    {
        Start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
        End = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(36).AddDays(-1)
    };
    private string message = "";
    private HashSet<int> expanded = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        using var db = DbFactory.CreateDbContext();
        projects = await db.Projects
            .Include(p => p.Payments)
            .OrderByDescending(p => p.Start)
            .ToListAsync();
    }

    private void ToggleExpand(int projectId)
    {
        if (!expanded.Remove(projectId))
            expanded.Add(projectId);
    }

    private async Task AddProject()
    {
        if (string.IsNullOrWhiteSpace(newProject.Title))
        {
            message = "Eingabe eines Titels ist notwendig.";
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            db.Projects.Add(newProject);
            await db.SaveChangesAsync();

            newProject.Payments = new List<Payment>();
            projects.Insert(0, newProject);
            message = $"Projekt '{newProject.Title}' hinzugefügt.";
            newProject = new()
            {
                Start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
                End = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(36).AddDays(-1)
            };
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task DeleteProject(Project project)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var toDelete = await db.Projects.Include(p => p.Payments).FirstOrDefaultAsync(p => p.Id == project.Id);
            if (toDelete != null)
            {
                db.Projects.Remove(toDelete);
                await db.SaveChangesAsync();
                projects.RemoveAll(p => p.Id == project.Id);
                message = "Projekt gelöscht.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private int? editingProjectId = null;
    private Project editProjectCopy = new();

    private void EditProject(Project p)
    {
        editingProjectId = p.Id;
        editProjectCopy = new Project { Id = p.Id, Title = p.Title, Start = p.Start, End = p.End };
    }

    private void CancelEditProject()
    {
        editingProjectId = null;
        editProjectCopy = new Project();
    }

    private async Task SaveProject(int id)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.Projects.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.Title = editProjectCopy.Title;
                dbItem.Start = editProjectCopy.Start;
                dbItem.End = editProjectCopy.End;
                await db.SaveChangesAsync();

                var idx = projects.FindIndex(x => x.Id == id);
                if (idx >= 0)
                {
                    projects[idx].Title = dbItem.Title;
                    projects[idx].Start = dbItem.Start;
                    projects[idx].End = dbItem.End;
                }
                message = "Projekt gespeichert.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            CancelEditProject();
        }
    }
}
