@page "/employees"

@using Microsoft.EntityFrameworkCore
@using System.Linq
@using oedibud.Models
@using oedibud.Data
@using oedibud.Components.Editable
@using oedibud.Services

@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject CsvImportService CsvImporter
@inject Microsoft.JSInterop.IJSRuntime JS
@inject oedibud.Services.CsvExportService CsvExporter

<PageTitle>Mitarbeiter</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="text-primary-emphasis mb-0">Mitarbeiter</h3>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv">
            <span class="bi bi-upload me-1" aria-hidden="true"></span>CSV Export
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => showImport = true">
            <span class="bi bi-download me-1" aria-hidden="true"></span>CSV Import
        </button>
    </div>
</div>
<hr />

<CsvImportDialog Title="Mitarbeiter importieren"
    @bind-IsOpen="showImport"
    OnImport="csv => CsvImporter.ImportEmployeesAsync(csv)"
    OnImportCompleted="LoadEmployees" />

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<table class="table table-striped">
    <colgroup>
        <col style="width: 1%" />
        <col />
        <col />
        <col />
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Eingestellt am</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Employee e in employees)
        {
            var isEditing = editingEmployeeId == e.Id;
            var edit = isEditing ? editEmployeeCopies[e.Id] : e;
            <tr>
                <td class="fst-italic">@e.Id</td>
                <td><EditableText @bind-Value="edit.Name" IsEditing="isEditing" /></td>
                <td><EditableDate @bind-Value="edit.HireDate" IsEditing="isEditing" /></td>
                <td>
                @if (isEditing)
                {
                    <button class="btn btn-sm btn-success me-2" @onclick="() => SaveEmployee(e.Id)">Speichern</button>
                    <button class="btn btn-sm btn-secondary me-2" @onclick="() => CancelEditEmployee(e.Id)">Abbrechen</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-primary btn-sm me-2" @onclick="() => EditEmployee(e)">Bearbeiten</button>
                    <button type="button" class="btn btn-danger btn-sm me-2" @onclick="@(a => Delete(e))">Löschen</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => overlayEmployee = e">Arbeitsverträge</button>
                }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td class="fst-italic text-muted">neu</td>
            <td><input class="form-control" placeholder="Name" @bind="employee.Name" /></td>
            <td><input type="date" class="form-control" @bind="employee.HireDate" /></td>
            <td><button type="button" class="btn btn-sm btn-success" @onclick="Add">Hinzufügen</button></td>
        </tr>
    </tfoot>
</table>

<SubTableOverlay IsVisible="overlayEmployee != null"
    Title="@(overlayEmployee != null ? $"Arbeitsverträge: {overlayEmployee.Name}" : "")"
    OnClose="() => overlayEmployee = null">
    @if (overlayEmployee != null)
    {
        <ContractTable
            contracts="allContracts"
            employees="employees"
            FilterEmployeeId="overlayEmployee.Id"
            ShowAddForm="true"
            OnMessageChanged="HandleContractMessage" />
    }
</SubTableOverlay>

@code {
    private Employee employee = new()
    {
        HireDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
    };

    private List<Employee> employees = new();
    private List<Contract> allContracts = new();
    
    private string message = "";
    private Employee? overlayEmployee = null;
    private bool showImport;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task ExportCsv()
    {
        var csv = CsvExporter.ExportEmployees(employees);
        await JS.InvokeVoidAsync("downloadFile", "employees.csv", csv);
    }

    private async Task LoadEmployees()
    {
        using var db = DbFactory.CreateDbContext();

        employees = await db.Employees
            .OrderByDescending(e => e.HireDate)
            .ToListAsync();

        allContracts = await db.Contracts
            .Include(c => c.Employee)
            .OrderByDescending(c => c.Start)
            .ToListAsync();
    }

    private async Task Add()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(employee.Name))
            {
                message = "Name darf nicht leer sein!";
                return;
            }

            using var db = DbFactory.CreateDbContext();

            var toSave = new Employee
            {
                Name = employee.Name,
                HireDate = employee.HireDate,
            };

            db.Employees.Add(toSave);
            await db.SaveChangesAsync();

            message = $"Mitarbeiter '{toSave.Name}' gespeichert!";

            employees.Insert(0, toSave);

            employee = new Employee { HireDate = DateTime.Today};
        }
        catch (Exception ex)
        {
            message = ex.ToString();
        }
    }

    private async Task Delete(Employee e)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            db.Employees.Remove(e);
            await db.SaveChangesAsync();

            message = $"Mitarbeiter '{e.Name}' gelöscht!";

            employees.Remove(e);
            allContracts.RemoveAll(c => c.EmployeeId == e.Id);
        }
        catch (Exception ex)
        {
            message = ex.ToString();
        }
    }

    // --- Inline editing support for Employees ---
    private int? editingEmployeeId = null;
    private Dictionary<int, Employee> editEmployeeCopies = new();

    private void EditEmployee(Employee e)
    {
        editingEmployeeId = e.Id;
        editEmployeeCopies[e.Id] = new Employee
        {
            Id = e.Id,
            Name = e.Name,
            HireDate = e.HireDate
        };
    }

    private async Task SaveEmployee(int id)
    {
        if (!editEmployeeCopies.TryGetValue(id, out var copy)) return;
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.Employees.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.Name = copy.Name;
                dbItem.HireDate = copy.HireDate;
                await db.SaveChangesAsync();

                var idx = employees.FindIndex(x => x.Id == id);
                if (idx >= 0)
                {
                    employees[idx].Name = dbItem.Name;
                    employees[idx].HireDate = dbItem.HireDate;
                }
                message = "Mitarbeiter gespeichert.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            editEmployeeCopies.Remove(id);
            editingEmployeeId = null;
        }
    }

    private void CancelEditEmployee(int id)
    {
        editEmployeeCopies.Remove(id);
        if (editingEmployeeId == id) editingEmployeeId = null;
    }

    private async Task HandleContractMessage(string msg)
    {
        message = msg;
        await InvokeAsync(StateHasChanged);
    }
}
