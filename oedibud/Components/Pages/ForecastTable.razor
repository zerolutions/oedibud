@using System.Diagnostics
@using oedibud.Services
@inject ForecastEngine Engine
@inject oedibud.Services.DataChangeNotifier Notifier
@inject UserSettingsService SettingsService

@implements IDisposable

@code {
    private bool QuarterView = false;
    private int Months => QuarterView ? 36 : 12;
    private DateTime StartMonth = new(DateTime.Today.Year, 1, 1);

    private ForecastEngine.ForecastResult? Result;

    private HashSet<int> ExpandedEmployees = new();
    private HashSet<int> ExpandedProjects = new();

    private Action? _onChangeHandler;

    protected override async Task OnInitializedAsync()
    {
        Notifier.OnChange -= _onChangeHandler;
        _onChangeHandler = () => _ = InvokeAsync(LoadDataAsync);
        Notifier.OnChange += _onChangeHandler;

        var saved = await SettingsService.LoadAsync();
        StartMonth = saved.StartMonth;
        QuarterView = saved.QuarterView;
        _savedExpandedEmployeeIds = UserSettingsService.DecodeIds(saved.ExpandedEmployeeIds);
        _savedExpandedProjectIds  = UserSettingsService.DecodeIds(saved.ExpandedProjectIds);

        await LoadDataAsync();
    }

    // Ids loaded from DB before the first forecast result is available
    private HashSet<int>? _savedExpandedEmployeeIds;
    private HashSet<int>? _savedExpandedProjectIds;

    private async Task LoadDataAsync()
    {
        Result = await Engine.BuildAsync(StartMonth, Months);

        // On first load restore saved state; on subsequent reloads keep current expansion
        if (_savedExpandedEmployeeIds is not null)
        {
            ExpandedEmployees = _savedExpandedEmployeeIds.Count > 0
                ? _savedExpandedEmployeeIds
                : GetTopLevelIds(ForecastEngine.RootKind.Employee);
            _savedExpandedEmployeeIds = null;
        }
        if (_savedExpandedProjectIds is not null)
        {
            ExpandedProjects = _savedExpandedProjectIds.Count > 0
                ? _savedExpandedProjectIds
                : GetTopLevelIds(ForecastEngine.RootKind.Project);
            _savedExpandedProjectIds = null;
        }
    }

    private async Task PersistSettingsAsync()
    {
        await SettingsService.SaveAsync(new oedibud.Models.UserSettings
        {
            StartMonth          = StartMonth,
            QuarterView         = QuarterView,
            ExpandedEmployeeIds = UserSettingsService.EncodeIds(ExpandedEmployees),
            ExpandedProjectIds  = UserSettingsService.EncodeIds(ExpandedProjects),
        });
    }

    private HashSet<int> GetTopLevelIds(ForecastEngine.RootKind kind) =>
        Result!.Nodes
            .Where(n => n.RootKind == kind && n.Level == 0)
            .Select(n => n.RootId)
            .ToHashSet();

    private async Task ToggleQuarterView()
    {
        QuarterView = !QuarterView;
        // Snap StartMonth to quarter start when switching to quarter view
        if (QuarterView)
        {
            var q = (StartMonth.Month - 1) / 3;
            StartMonth = new DateTime(StartMonth.Year, q * 3 + 1, 1);
        }
        await LoadDataAsync();
        await PersistSettingsAsync();
    }

    // Display columns: 12 months or 12 quarters aggregated from 36 months
    private IReadOnlyList<string> DisplayColumns => QuarterView
        ? Enumerable.Range(0, 12)
            .Select(i => {
                var q = StartMonth.AddMonths(i * 3);
                return $"Q{(q.Month - 1) / 3 + 1} {q.Year}";
            }).ToList()
        : Result!.Columns.Select(c => c.ToString("MMM yy")).ToList();

    // Aggregate monthly values into 12 quarterly values (sum of 3 consecutive months)
    private decimal[] AggregateToQuarters(decimal[] monthly)
    {
        var result = new decimal[12];
        for (int q = 0; q < 12; q++)
            result[q] = monthly[q * 3] + monthly[q * 3 + 1] + monthly[q * 3 + 2];
        return result;
    }

    private decimal[] DisplayValues(decimal[] raw) =>
        QuarterView ? AggregateToQuarters(raw) : raw;

    public async Task NextMonth(int m)
    {
        Debug.WriteLine("NextMonthClicked");
        StartMonth = StartMonth.AddMonths(m);
        await LoadDataAsync();
        await PersistSettingsAsync();
    }

    private async Task ToggleEmployee(int empId)
    {
        if (ExpandedEmployees.Contains(empId)) ExpandedEmployees.Remove(empId);
        else ExpandedEmployees.Add(empId);
        await PersistSettingsAsync();
    }

    private async Task ToggleProject(int projectId)
    {
        if (ExpandedProjects.Contains(projectId)) ExpandedProjects.Remove(projectId);
        else ExpandedProjects.Add(projectId);
        await PersistSettingsAsync();
    }

    private async Task ExpandAllProjects()
    {
        ExpandedProjects = GetTopLevelIds(ForecastEngine.RootKind.Project);
        await PersistSettingsAsync();
    }

    private async Task CollapseAllProjects()
    {
        ExpandedProjects.Clear();
        await PersistSettingsAsync();
    }

    private async Task ExpandAllEmployees()
    {
        ExpandedEmployees = GetTopLevelIds(ForecastEngine.RootKind.Employee);
        await PersistSettingsAsync();
    }

    private async Task CollapseAllEmployees()
    {
        ExpandedEmployees.Clear();
        await PersistSettingsAsync();
    }

    void IDisposable.Dispose()
    {
        if (_onChangeHandler != null)
            Notifier.OnChange -= _onChangeHandler;
    }
    private string FormatCurrencyShort(decimal value)
    {
        var abs = Math.Abs(value);

        if (abs >= 1_000)
            return $"{value / 1_000:0.}k €";

        return value.ToString("C0");
    }
}

<h3 class="text-primary-emphasis">Prognose</h3>
<hr />

<div style="display:flex; justify-content:center; align-items:center; gap:0.5rem">
    <button type="button" class="btn btn-sm btn-light" title="@(QuarterView ? "3 Quartale zurück" : "12 Monate zurück")" @onclick="@(e => NextMonth(QuarterView ? -9 : -12))">⬅️⬅️</button>
    <button type="button" class="btn btn-sm btn-light" title="@(QuarterView ? "1 Quartal zurück" : "1 Monat zurück")" @onclick="@(e => NextMonth(QuarterView ? -3 : -1))">⬅️</button>
    <h4 class="m-2">@StartMonth.ToString("MMM yy") - @StartMonth.AddMonths(@Months).AddDays(-1).ToString("MMM yy")</h4>
    <button type="button" class="btn btn-sm btn-light" title="@(QuarterView ? "1 Quartal vorwärts" : "1 Monat vorwärts")" @onclick="@(e => NextMonth(QuarterView ? 3 : 1))">➡️</button>
    <button type="button" class="btn btn-sm btn-light" title="@(QuarterView ? "3 Quartale vorwärts" : "12 Monate vorwärts")" @onclick="@(e => NextMonth(QuarterView ? 9 : 12))">➡️➡️</button>
    <div class="form-check form-switch ms-4 mb-0 d-flex align-items-center">
        <input class="form-check-input" type="checkbox" id="quarterSwitch" checked="@QuarterView" @onchange="ToggleQuarterView" style="cursor:pointer" />
        <label class="form-check-label ms-2" for="quarterSwitch">Quartalsansicht</label>
    </div>
</div>

@if (Result is null)
{
    <p>Lade…</p>
}
else
{
    <h4 class="mt-5 text-center">Projektbudgets (kummuliert)</h4>

    @* -------------------------
       Tabelle 1: Projekt-Sicht
       ------------------------- *@
    <table class="table table-sm table-borderless mt-3 text-end table-hover">
        <thead>
            <tr>
                <th>
                    <button class="btn btn-sm btn-outline-secondary pb-0 pt-0" title="Alle ausklappen" @onclick="ExpandAllProjects">+</button>
                    <button class="btn btn-sm btn-outline-secondary pb-0 pt-0" title="Alle einklappen" @onclick="CollapseAllProjects">−</button>
                </th>
                @foreach (var col in DisplayColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Result.Nodes.Where(n => n.RootKind == ForecastEngine.RootKind.Project))
            {
                if (row.Level > 0 && !ExpandedProjects.Contains(row.RootId)) { continue; }
                var vals = DisplayValues(row.Values);

                if (row.Level == 0)
                {
                    <tr class="table-danger fw-bold">
                        <td>
                            <button title="@row.Title" class="btn btn-sm pb-0 pt-0 fw-bold" @onclick="() => ToggleProject(row.RootId)">
                                @(ExpandedProjects.Contains(row.RootId) ? "- " : "+ ") @((MarkupString)row.Label)
                            </button>
                        </td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td class="@(@vals[i] < 0 ? "text-danger" : "")">@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
                else if (row.Level == 1)
                {
                    <tr class="table-success">
                        <td title="@row.Title" style="padding-left:10px">@((MarkupString)row.Label)</td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td class="@(@vals[i] < 0 ? "text-danger" : "")">@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
                else
                {
                    <tr class="table-secondary">
                        <td title="@row.Title" style="padding-left:20px">@((MarkupString)row.Label)</td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td>@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="table-dark fw-bold">
                @* <td /> *@
                <td>Gesamt</td>
                @{ var projTotals = DisplayValues(Result.ProjectTotals); }
                @for (int i = 0; i < projTotals.Length; i++)
                {
                    <td class="@(@projTotals[i] < 0 ? "text-danger" : "")">@FormatCurrencyShort(projTotals[i])</td>
                }
            </tr>
        </tfoot>
    </table>

    @* -------------------------
       Tabelle 2: Mitarbeiter-Sicht
       ------------------------- *@
    <h4 class="mt-5 text-center">Personalsaldo (nicht kummuliert)</h4>
    <table class="table table-sm table-borderless mt-3 text-end table-hover">
        <thead>
            <tr>
                <th>
                    <button class="btn btn-sm btn-outline-secondary pb-0 pt-0" title="Alle ausklappen" @onclick="ExpandAllEmployees">+</button>
                    <button class="btn btn-sm btn-outline-secondary pb-0 pt-0" title="Alle einklappen" @onclick="CollapseAllEmployees">−</button>
                </th>
                @foreach (var col in DisplayColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Result.Nodes.Where(n => n.RootKind == ForecastEngine.RootKind.Employee))
            {
                if (row.Level > 0 && !ExpandedEmployees.Contains(row.RootId)) { continue; }
                var vals = DisplayValues(row.Values);

                if (row.Level == 0)
                {
                    <tr class="table-primary fw-bold">
                        <td>
                            <button  title="@row.Title" class="btn btn-sm btn-outline-secondary pb-0 pt-0 fw-bold" @onclick="() => ToggleEmployee(row.RootId)">
                                 @(ExpandedEmployees.Contains(row.RootId) ? "- " : "+ ") @((MarkupString)row.Label)
                            </button> 
                        </td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td class="@(@vals[i] < 0 ? "text-danger" : "")">@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
                else if (row.Level == 1)
                {
                    <tr class="table-secondary">
                        <td title="@row.Title" style="padding-left:10px">@((MarkupString)row.Label)</td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td>@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
                else
                {
                    <tr class="table-success">
                        <td title="@row.Title" style="padding-left:20px">@((MarkupString)row.Label)</td>
                        @for (int i = 0; i < vals.Length; i++)
                        {
                            <td>@FormatCurrencyShort(vals[i])</td>
                        }
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="table-dark fw-bold">
                <td>Gesamt</td>
                @{ var empTotals = DisplayValues(Result.EmployeeTotals); }
                @for (int i = 0; i < empTotals.Length; i++)
                {
                    <td class="@(@empTotals[i] < 0 ? "text-danger" : "")">@FormatCurrencyShort(empTotals[i])</td>
                }
            </tr>
        </tfoot>
    </table>

}
