@page "/payments"

@using Microsoft.EntityFrameworkCore
@using oedibud.Models
@using oedibud.Data
@using oedibud.Services
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject oedibud.Services.DataChangeNotifier Notifier
@inject CsvImportService CsvImporter
@inject Microsoft.JSInterop.IJSRuntime JS
@inject oedibud.Services.CsvExportService CsvExporter

<PageTitle>Projektmittel</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="text-primary-emphasis mb-0">Projektmittel</h3>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv">
            <span class="bi bi-upload me-1" aria-hidden="true"></span>CSV Export
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => showImport = true">
            <span class="bi bi-download me-1" aria-hidden="true"></span>CSV Import
        </button>
    </div>
</div>
<hr />

<CsvImportDialog Title="Projektmittel importieren"
    @bind-IsOpen="showImport"
    OnImport="csv => CsvImporter.ImportPaymentsAsync(csv)"
    OnImportCompleted="ReloadData" />

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<PaymentTable
    payments="payments"
    projects="projects"
    contracts="contracts"
    ShowContractAssignments="true"
    ShowAddForm="true"
    OnMessageChanged="m => { message = m; StateHasChanged(); }" />

@code {
    private List<Payment> payments = new();
    private List<Project> projects = new();
    private List<Contract> contracts = new();
    private string message = string.Empty;
    private bool showImport;

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
    }

    private async Task ExportCsv()
    {
        var csv = CsvExporter.ExportPayments(payments);
        await JS.InvokeVoidAsync("downloadFile", "payments.csv", csv);
    }

    private async Task ReloadData()
    {
        using var db = DbFactory.CreateDbContext();
        contracts = await db.Contracts
            .Include(c => c.Employee)
            .OrderByDescending(c => c.Start)
            .ToListAsync();
        projects = await db.Projects.OrderByDescending(p => p.Start).ToListAsync();
        payments = await db.Payments
            .Include(p => p.Project)
            .Include(p => p.ContractPayments)
                .ThenInclude(cp => cp.Contract)
                    .ThenInclude(c => c!.Employee)
            .OrderByDescending(p => p.Start)
            .ToListAsync();
        StateHasChanged();
    }
}
