@page "/contracts"

@using Microsoft.EntityFrameworkCore
@using oedibud.Models
@using oedibud.Data
@inject IDbContextFactory<BudgetDbContext> DbFactory

<PageTitle>Arbeitsverträge</PageTitle>

<h3 class="text-primary-emphasis">Arbeitsverträge</h3>
<hr />

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<ContractTable
    contracts="contracts"
    employees="employees"
    payments="payments"
    projects="projects"
    ShowContractPayments="true"
    ShowAddForm="true"
    OnMessageChanged="m => { message = m; StateHasChanged(); }" />

@code {
    private List<Contract> contracts = new();
    private List<Employee> employees = new();
    private List<Payment> payments = new();
    private List<Project> projects = new();
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        employees = await db.Employees.OrderBy(e => e.Name).ToListAsync();
        projects = await db.Projects.OrderByDescending(p => p.Start).ToListAsync();
        payments = await db.Payments
            .Include(p => p.Project)
            .OrderByDescending(p => p.Start)
            .ToListAsync();
        contracts = await db.Contracts
            .Include(c => c.Employee)
            .Include(c => c.ContractPayments)
                .ThenInclude(cp => cp.Payment)
                    .ThenInclude(p => p!.Project)
            .OrderByDescending(c => c.Start)
            .ToListAsync();
    }
}
