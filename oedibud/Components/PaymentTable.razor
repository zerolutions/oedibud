@using Microsoft.EntityFrameworkCore
@using System.Linq
@using oedibud.Models
@using oedibud.Data
@using oedibud.Components.Editable
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject oedibud.Services.DataChangeNotifier Notifier

@{
    var displayPayments = FilterProjectId.HasValue
        ? payments.Where(p => p.ProjectId == FilterProjectId.Value).OrderByDescending(p => p.Start).ToList()
        : payments.OrderByDescending(p => p.Start).ToList();
    bool showProjectCol = !FilterProjectId.HasValue;
    int colSpan = showProjectCol ? 8 : 6;
    string tableClass = Compact ? "table table-sm" : "table table-striped";
    string overlayTitle = overlayPayment == null ? "" :
        $"Vertragszuweisungen · PM-{overlayPayment.Id} · {overlayPayment.Title ?? "-"} · {overlayPayment.Start.ToShortDateString()} – {overlayPayment.End.ToShortDateString()}";
}

@if (!displayPayments.Any() && !ShowAddForm)
{
    <p><em>Keine Projektmittel vorhanden.</em></p>
}
else
{
    <table class="@tableClass">
        <thead>
            <tr>
                <th>ID</th>
                @if (showProjectCol)
                {
                    <th>Projekt</th>
                }
                <th>Titel</th>
                <th>Von</th>
                <th>Bis</th>
                <th>Betrag</th>
                <th>Gewidmet</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in displayPayments)
            {
                var isEditing = editingPaymentIds.Contains(p.Id);
                var edit = isEditing ? editPaymentCopies[p.Id] : p;

                <tr>
                    <td class="fst-italic">@p.Id</td>
                    @if (showProjectCol)
                    {
                        <td>
                            <EditableSelect @bind-Value="edit.ProjectId"
                                IsEditing="isEditing"
                                DisplayText="@(p.Project?.Title ?? projects.FirstOrDefault(pr => pr.Id == p.ProjectId)?.Title ?? "-")"
                                Items="projects.Select(pr => new EditableSelect<int>.SelectItem{ Value = pr.Id, Text = pr.Title })" />
                        </td>
                    }
                    <td><EditableText @bind-Value="edit.Title" IsEditing="isEditing" /></td>
                    <td><EditableDate @bind-Value="edit.Start" IsEditing="isEditing" /></td>
                    <td><EditableDate @bind-Value="edit.End" IsEditing="isEditing" /></td>
                    <td><EditableNumber @bind-Value="edit.Amount" IsEditing="isEditing" Step="1" DisplayText="@(isEditing ? null : p.Amount.ToString("C"))" /></td>
                    <td>
                        @if (isEditing)
                        {
                            <select class="form-control" @bind="edit.DetecatedTo">
                                <option value="">-- keine Angabe --</option>
                                @foreach (var g in Enum.GetValues<EmployeeGroup>())
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        }
                        else
                        {
                            @(p.DetecatedTo?.ToString() ?? "-")
                        }
                    </td>
                    <td>
                        @if (isEditing)
                        {
                            <button class="btn btn-sm btn-success me-1" @onclick="() => SavePayment(p.Id)">Speichern</button>
                            <button class="btn btn-sm btn-secondary me-1" @onclick="() => CancelEditPayment(p.Id)">Abbrechen</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditPayment(p)">Bearbeiten</button>
                            <button class="btn btn-sm btn-danger me-1" @onclick="() => DeletePayment(p)">Löschen</button>
                            @if (ShowContractAssignments)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowPaymentOverlay(p)">Verträge zuweisen</button>
                            }
                        }
                    </td>
                </tr>
            }
            @if (ShowAddForm)
            {
                <tr>
                    <td class="fst-italic text-muted">neu</td>
                    @if (showProjectCol)
                    {
                        <td>
                            <select class="form-control" @bind="newPaymentInput.ProjectId">
                                <option value="0">-- auswählen --</option>
                                @foreach (var pr in projects)
                                {
                                    <option value="@pr.Id">@pr.Title</option>
                                }
                            </select>
                        </td>
                    }
                    <td><EditableText @bind-Value="newPaymentInput.Title" IsEditing="true" /></td>
                    <td><EditableDate @bind-Value="newPaymentInput.Start" IsEditing="true" /></td>
                    <td><EditableDate @bind-Value="newPaymentInput.End" IsEditing="true" /></td>
                    <td><EditableNumber @bind-Value="newPaymentInput.Amount" IsEditing="true" Step="1" /></td>
                    <td>
                        <select class="form-control" @bind="newPaymentInput.DetecatedTo">
                            <option value="">-- keine Angabe --</option>
                            @foreach (var g in Enum.GetValues<EmployeeGroup>())
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="AddPayment">Hinzufügen</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <SubTableOverlay IsVisible="overlayPayment != null" Title="@overlayTitle" OnClose="ClosePaymentOverlay">
        @if (overlayPayment != null)
        {
            @if (overlayPayment.ContractPayments == null || overlayPayment.ContractPayments.Count == 0)
            {
                <em>Keine Arbeitsverträge zugewiesen.</em>
            }
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Mitarbeiter</th>
                        <th>AV-ID</th>
                        <th>Lohnanteil</th>
                        <th>Reallohnanteil</th>
                        <th>Von</th>
                        <th>Bis</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cp in (overlayPayment.ContractPayments ?? new List<ContractPayment>()).OrderByDescending(x => x.ContractShare))
                    {
                        var isEditingCA = editingContractAssignIds.Contains(cp.Id);
                        var editCA = isEditingCA ? editContractAssignCopies[cp.Id] : cp;
                        var caContractItems = ContractsForContractAssignEdit(overlayPayment, cp.ContractId)
                            .Select(c => new EditableSelect<int>.SelectItem { Value = c.Id, Text = GetContractLabel(c.Id) });

                        <tr>
                            @if (isEditingCA)
                            {
                                <td colspan="2"><EditableSelect @bind-Value="editCA.ContractId" IsEditing="true" DisplayText="@(cp.Contract?.Employee?.Name ?? "-")" Items="caContractItems" /></td>
                            }
                            else{
                                <td>@(cp.Contract?.Employee?.Name ?? "-")</td>
                                <td>@($"AV-{cp.ContractId}")</td>
                            }
                            <td><EditablePercent @bind-Value="editCA.ContractSharePercent" IsEditing="isEditingCA" Step="1" /></td>
                            <td>@(editCA.ContractSharePercent * (contracts.FirstOrDefault(c => c.Id == editCA.ContractId)?.Fte ?? 0))</td>
                            <td><EditableNullableDate @bind-Value="editCA.Start" IsEditing="isEditingCA" /></td>
                            <td><EditableNullableDate @bind-Value="editCA.End" IsEditing="isEditingCA" /></td>
                            <td>
                                @if (isEditingCA)
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => SaveContractAssignment(cp.Id, overlayPayment)">Speichern</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => CancelEditContractAssignment(cp.Id)">Abbrechen</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditContractAssignment(cp)">Bearbeiten</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteContractAssignment(cp.Id, overlayPayment)">Entfernen</button>
                                }
                            </td>
                        </tr>
                    }
                    @{
                        var newCAInput = GetOrAddContractAssignInput(overlayPayment.Id);
                        var newCAContractItems = new[] { new EditableSelect<int>.SelectItem { Value = 0, Text = "-- auswählen --" } }
                            .Concat(AvailableContractsForPayment(overlayPayment).Select(c => new EditableSelect<int>.SelectItem { Value = c.Id, Text = GetContractLabel(c.Id) }));
                    }
                    <tr>
                        <td colspan="2"><EditableSelect @bind-Value="newCAInput.ContractId" IsEditing="true" DisplayText="-- auswählen --" Items="newCAContractItems" /></td>
                        <td><EditablePercent @bind-Value="newCAInput.ContractSharePercent" IsEditing="true" Step="1" /></td>
                        <td></td>
                        <td><EditableNullableDate @bind-Value="newCAInput.Start" IsEditing="true" /></td>
                        <td><EditableNullableDate @bind-Value="newCAInput.End" IsEditing="true" /></td>
                        <td><button class="btn btn-sm btn-success" @onclick="() => AddContractAssignment(overlayPayment)">Zuweisen</button></td>
                    </tr>
                </tbody>
            </table>
        }
    </SubTableOverlay>
}

@code {
    [Parameter] public List<Payment> payments { get; set; } = new();
    [Parameter] public List<Project> projects { get; set; } = new();
    [Parameter] public List<Contract> contracts { get; set; } = new();
    [Parameter] public int? FilterProjectId { get; set; }
    [Parameter] public bool ShowContractAssignments { get; set; } = false;
    [Parameter] public bool ShowAddForm { get; set; } = true;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public EventCallback<string> OnMessageChanged { get; set; }



    private Payment newPaymentInput = new();
    private HashSet<int> editingPaymentIds = new();
    private Dictionary<int, Payment> editPaymentCopies = new();

    private Payment? overlayPayment = null;
    private Dictionary<int, ContractPayment> contractAssignInputs = new();
    private HashSet<int> editingContractAssignIds = new();
    private Dictionary<int, ContractPayment> editContractAssignCopies = new();

    protected override void OnInitialized()
    {
        newPaymentInput.ProjectId = FilterProjectId ?? 0;
        if (FilterProjectId.HasValue)
        {
            var proj = projects.FirstOrDefault(p => p.Id == FilterProjectId.Value);
            if (proj != null)
            {
                newPaymentInput.Start = proj.Start;
                newPaymentInput.End = proj.End;
            }
        }
    }

    private ContractPayment GetOrAddContractAssignInput(int paymentId)
    {
        if (!contractAssignInputs.TryGetValue(paymentId, out var input))
        {
            input = new ContractPayment();
            contractAssignInputs[paymentId] = input;
        }
        return input;
    }

    private IEnumerable<Contract> ContractsForContractAssignEdit(Payment p, int currentContractId)
    {
        var current = contracts.FirstOrDefault(c => c.Id == currentContractId);
        var available = AvailableContractsForPayment(p);
        return current != null ? available.Prepend(current) : available;
    }

    private IEnumerable<Contract> AvailableContractsForPayment(Payment p)
    {
        EmployeeGroup? paymentGroup = p.DetecatedTo;
        var assignedIds = p.ContractPayments?.Select(x => x.ContractId).ToHashSet() ?? new HashSet<int>();
        return contracts.Where(c => !assignedIds.Contains(c.Id) && (paymentGroup == null || (c.Employee != null && c.Group == paymentGroup))
            );
    }

    private string GetContractLabel(int contractId)
    {
        var c = contracts.FirstOrDefault(x => x.Id == contractId);
        if (c == null) return $"AV-{contractId}";
        return $"{c.Employee?.Name ?? "-"} | AV-{c.Id}"; // ({c.Start.ToShortDateString()} – {c.End.ToShortDateString()})
    }

    private void ShowPaymentOverlay(Payment p)
    {
        overlayPayment = p;
        if (!contractAssignInputs.ContainsKey(p.Id))
            contractAssignInputs[p.Id] = new ContractPayment();
    }

    private void ClosePaymentOverlay()
    {
        overlayPayment = null;
    }

    // --- Payment CRUD ---

    private void EditPayment(Payment p)
    {
        editingPaymentIds.Add(p.Id);
        editPaymentCopies[p.Id] = new Payment
        {
            Id = p.Id,
            ProjectId = p.ProjectId,
            Title = p.Title,
            Start = p.Start,
            End = p.End,
            Amount = p.Amount,
            DetecatedTo = p.DetecatedTo,
            Project = p.Project
        };
    }

    private void CancelEditPayment(int id)
    {
        editingPaymentIds.Remove(id);
        editPaymentCopies.Remove(id);
    }

    private async Task SavePayment(int id)
    {
        if (!editPaymentCopies.TryGetValue(id, out var copy)) return;
        if (string.IsNullOrWhiteSpace(copy.Title))
        {
            await OnMessageChanged.InvokeAsync("Bitte einen Titel vergeben.");
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.Payments.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.ProjectId = copy.ProjectId;
                dbItem.Title = copy.Title;
                dbItem.Start = copy.Start;
                dbItem.End = copy.End;
                dbItem.Amount = copy.Amount;
                dbItem.DetecatedTo = copy.DetecatedTo;
                await db.SaveChangesAsync();

                var idx = payments.FindIndex(x => x.Id == id);
                if (idx >= 0)
                {
                    payments[idx].ProjectId = dbItem.ProjectId;
                    payments[idx].Project = projects.FirstOrDefault(pr => pr.Id == dbItem.ProjectId) ?? payments[idx].Project;
                    payments[idx].Title = dbItem.Title;
                    payments[idx].Start = dbItem.Start;
                    payments[idx].End = dbItem.End;
                    payments[idx].Amount = dbItem.Amount;
                    payments[idx].DetecatedTo = dbItem.DetecatedTo;
                }
                await OnMessageChanged.InvokeAsync("Projektmittel gespeichert.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
        finally
        {
            CancelEditPayment(id);
        }
    }

    private async Task AddPayment()
    {
        var projectId = FilterProjectId ?? newPaymentInput.ProjectId;
        if (projectId == 0)
        {
            await OnMessageChanged.InvokeAsync("Bitte ein Projekt auswählen.");
            return;
        }
        if (string.IsNullOrWhiteSpace(newPaymentInput.Title))
        {
            await OnMessageChanged.InvokeAsync("Bitte einen Titel vergeben.");
            return;
        }
        if (newPaymentInput.Amount == 0m)
        {
            await OnMessageChanged.InvokeAsync("Betrag muss größer als 0 sein.");
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            var toSave = new Payment
            {
                ProjectId = projectId,
                Title = newPaymentInput.Title,
                Start = newPaymentInput.Start,
                End = newPaymentInput.End,
                Amount = newPaymentInput.Amount,
                DetecatedTo = newPaymentInput.DetecatedTo
            };
            db.Payments.Add(toSave);
            await db.SaveChangesAsync();

            var saved = await db.Payments.Include(p => p.Project).FirstOrDefaultAsync(p => p.Id == toSave.Id);
            if (saved != null)
            {
                saved.ContractPayments = new List<ContractPayment>();
                payments.Insert(0, saved);
            }
            Notifier.Notify();
            await OnMessageChanged.InvokeAsync("Projektmittel hinzugefügt.");

            if (FilterProjectId.HasValue)
            {
                var proj = projects.FirstOrDefault(p => p.Id == FilterProjectId.Value);
                newPaymentInput = new Payment
                {
                    ProjectId = FilterProjectId.Value,
                    Start = proj?.Start ?? DateTime.Today,
                    End = proj?.End ?? DateTime.Today
                };
            }
            else
            {
                newPaymentInput = new Payment { ProjectId = newPaymentInput.ProjectId };
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    private async Task DeletePayment(Payment p)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var item = await db.Payments.FindAsync(p.Id);
            if (item != null)
            {
                db.Payments.Remove(item);
                await db.SaveChangesAsync();
                payments.RemoveAll(x => x.Id == p.Id);
                contractAssignInputs.Remove(p.Id);
                Notifier.Notify();
                await OnMessageChanged.InvokeAsync("Projektmittel gelöscht.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    // --- Contract Assignment CRUD ---

    private void EditContractAssignment(ContractPayment cp)
    {
        editingContractAssignIds.Add(cp.Id);
        editContractAssignCopies[cp.Id] = new ContractPayment
        {
            Id = cp.Id,
            ContractId = cp.ContractId,
            PaymentId = cp.PaymentId,
            ContractShare = cp.ContractShare,
            Start = cp.Start,
            End = cp.End
        };
    }

    private void CancelEditContractAssignment(int id)
    {
        editingContractAssignIds.Remove(id);
        editContractAssignCopies.Remove(id);
    }

    private async Task SaveContractAssignment(int id, Payment p)
    {
        if (!editContractAssignCopies.TryGetValue(id, out var copy)) return;
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.ContractPayments.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.ContractShare = copy.ContractShare;
                dbItem.Start = copy.Start;
                dbItem.End = copy.End;
                dbItem.ContractId = copy.ContractId;
                await db.SaveChangesAsync();

                var idx = p.ContractPayments?.FindIndex(x => x.Id == id) ?? -1;
                if (idx >= 0)
                {
                    p.ContractPayments![idx].ContractShare = dbItem.ContractShare;
                    p.ContractPayments![idx].Start = dbItem.Start;
                    p.ContractPayments![idx].End = dbItem.End;
                    p.ContractPayments![idx].ContractId = dbItem.ContractId;
                    var loaded = await db.ContractPayments
                        .Include(x => x.Contract).ThenInclude(c => c!.Employee)
                        .FirstOrDefaultAsync(x => x.Id == id);
                    if (loaded != null) p.ContractPayments![idx].Contract = loaded.Contract;
                }
                Notifier.Notify();
                await OnMessageChanged.InvokeAsync("Zuweisung gespeichert.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
        finally
        {
            CancelEditContractAssignment(id);
        }
    }

    private async Task AddContractAssignment(Payment p)
    {
        var input = GetOrAddContractAssignInput(p.Id);
        if (input.ContractId == 0)
        {
            await OnMessageChanged.InvokeAsync("Bitte einen Vertrag auswählen.");
            return;
        }
        if (input.ContractShare < 0 || input.ContractShare > 1)
        {
            await OnMessageChanged.InvokeAsync("Lohnanteil muss zwischen 0 und 100 liegen.");
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            var cp = new ContractPayment
            {
                PaymentId = p.Id,
                ContractId = input.ContractId,
                ContractShare = input.ContractShare,
                Start = input.Start,
                End = input.End
            };
            db.Add(cp);
            await db.SaveChangesAsync();

            var loaded = await db.ContractPayments
                .Include(x => x.Contract).ThenInclude(c => c!.Employee)
                .FirstOrDefaultAsync(x => x.Id == cp.Id);
            if (loaded != null)
            {
                p.ContractPayments ??= new List<ContractPayment>();
                p.ContractPayments.Add(loaded);
            }
            Notifier.Notify();
            await OnMessageChanged.InvokeAsync("Vertrag zugewiesen.");
            contractAssignInputs[p.Id] = new ContractPayment();
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    private async Task DeleteContractAssignment(int contractPaymentId, Payment p)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var item = await db.ContractPayments.FindAsync(contractPaymentId);
            if (item != null)
            {
                db.ContractPayments.Remove(item);
                await db.SaveChangesAsync();
                p.ContractPayments?.RemoveAll(x => x.Id == contractPaymentId);
                Notifier.Notify();
                await OnMessageChanged.InvokeAsync("Zuweisung entfernt.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }
}