@using Microsoft.EntityFrameworkCore
@using System.Linq
@using oedibud.Models
@using oedibud.Data
@using oedibud.Components.Editable
@inject IDbContextFactory<BudgetDbContext> DbFactory

@{
    var displayContracts = GetFilteredContracts();
    int colSpan = FilterEmployeeId.HasValue ? 5 : 6;
    string tableClass = Compact ? "table table-sm" : "table table-striped";
    string overlayTitle = overlayContract == null ? "" :
        $"Projektmittel · AV-{overlayContract.Id} · {overlayContract.Employee?.Name ?? employees.FirstOrDefault(e => e.Id == overlayContract.EmployeeId)?.Name ?? "-"} · {overlayContract.Start.ToShortDateString()} – {overlayContract.End.ToShortDateString()} ({overlayContract.FtePercent}%)";
}

@if (!displayContracts.Any() && !ShowAddForm)
{
    <p><em>Keine Arbeitsverträge vorhanden.</em></p>
}
else
{
    <table class="@tableClass">
        <thead>
            <tr>
                <th>ID</th>
                @if (!FilterEmployeeId.HasValue)
                {
                    <th>Mitarbeiter</th>
                }
                <th>Start</th>
                <th>Ende</th>
                <th title="Stellenanteil">Anteil</th>
                <th title="Eingruppierung">Gruppe</th>
                <th title="Stufe zu Vertragsbeginn">Stufe</th>
                <th title="Zusätzlich zur Stufe angerechnete Monate zu Vertragsbeginn">+ Monate</th>
                <th title="Arbeitgeber Auslage">AG Auslage</th>
                <th title="Jährlich im November fällig">Jahressonderzahlung</th>
                <th title="Nächste Stufe am">Nächste Stufe</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (Contract c in displayContracts)
        {
            var isEditing = editingContractIds.Contains(c.Id);
            var edit = isEditing ? editContractCopies[c.Id] : c;

            <tr>
                <td>@c.Id</td>

                @if (!FilterEmployeeId.HasValue)
                {
                    <td><EditableSelect @bind-Value="edit.EmployeeId" IsEditing="isEditing" DisplayText="@employees.FirstOrDefault(e => e.Id == c.EmployeeId)?.Name" Items="@employees.Select(e => new EditableSelect<int>.SelectItem{ Value = e.Id, Text = e.Name })" /></td>
                }

                <td><EditableDate @bind-Value="edit.Start" IsEditing="isEditing" /></td>
                <td><EditableDate @bind-Value="edit.End" IsEditing="isEditing" /></td>
                <td><EditablePercent @bind-Value="edit.FtePercent" IsEditing="isEditing" /></td>
                <td><EditableSelect @bind-Value="edit.Group" IsEditing="isEditing" DisplayText="@c.Group.ToString()" Items="Enum.GetValues<EmployeeGroup>().Select(g => new EditableSelect<EmployeeGroup>.SelectItem{ Value = g, Text = GetGroupName(g) })" /></td>
                <td><EditableNumber @bind-Value="edit.Level" IsEditing="isEditing" Min="1" Max="6" /></td>
                <td><EditableNumber @bind-Value="edit.ExperienceMonth" IsEditing="isEditing" Min="0" /></td>
                <td><EditablePercent @bind-Value="edit.EmployerBruttoAdditionPercent" IsEditing="isEditing" /></td>
                <td><EditablePercent @bind-Value="edit.AnualPaymentAdditionPercent" IsEditing="isEditing" /></td>
                <td class="fst-italic">@c.NextLevel.ToShortDateString()</td>
                <td>
                    @if (isEditing)
                    {
                        <button class="btn btn-sm btn-success me-2" @onclick="() => SaveContract(c.Id)">Speichern</button>
                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => CancelEditContract(c.Id)">Abbrechen</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => EditContract(c)">Bearbeiten</button>
                        <button class="btn btn-danger btn-sm me-2" @onclick="@(a => DeleteContract(c.Id))">Löschen</button>
                    }
                </td>
            </tr>
        }

        @if (ShowAddForm)
        {
            <tr>
                <td class="fst-italic text-muted">neu</td>

                @if (!FilterEmployeeId.HasValue)
                {
                    <td><EditableSelect @bind-Value="newContractInput.EmployeeId" IsEditing="true" Items="employees.Select(e => new EditableSelect<int>.SelectItem{ Value = e.Id, Text = e.Name })" /></td>
                }

                <td><EditableDate @bind-Value="newContractInput.Start" IsEditing="true" /></td>
                <td><EditableDate @bind-Value="newContractInput.End" IsEditing="true" /></td>
                <td><EditablePercent @bind-Value="newContractInput.FtePercent" IsEditing="true" /></td>
                <td><EditableSelect @bind-Value="newContractInput.Group" IsEditing="true" Items="Enum.GetValues<EmployeeGroup>().Select(g => new EditableSelect<EmployeeGroup>.SelectItem{ Value = g, Text = GetGroupName(g) })" /></td>
                <td><EditableNumber @bind-Value="newContractInput.Level" IsEditing="true" Min="1" Max="6" /></td>
                <td><EditableNumber @bind-Value="newContractInput.ExperienceMonth" IsEditing="true" Min="0" /></td>
                <td><EditablePercent @bind-Value="newContractInput.EmployerBruttoAdditionPercent" IsEditing="true" /></td>
                <td><EditablePercent @bind-Value="newContractInput.AnualPaymentAdditionPercent" IsEditing="true" /></td>

                <td></td>

                <td><button class="btn btn-success btn-sm" @onclick="AddContract">Hinzufügen</button></td>
            </tr>
        }
        </tbody>
    </table>

    <SubTableOverlay IsVisible="overlayContract != null" Title="@overlayTitle" OnClose="CloseContractOverlay">
        @if (overlayContract != null)
        {
            @if (overlayContract.ContractPayments == null || overlayContract.ContractPayments.Count == 0)
            {
                <em>Keine Projektmittel zugewiesen.</em>
            }
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Projekt</th>
                        <th>PM-ID</th>
                        <th>Zeitraum</th>
                        <th>Betrag</th>
                        <th>Lohnanteil</th>
                        <th>Reallohnanteil</th>
                        <th>Von</th>
                        <th>Bis</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cp in (overlayContract.ContractPayments ?? new List<ContractPayment>()).OrderByDescending(x => x.Payment?.Start))
                    {
                        <tr>
                            @if (editingContractPaymentIds.Contains(cp.Id))
                            {
                                <td colspan="4">
                                    <select class="form-control" @bind="editContractPaymentCopies[cp.Id].PaymentId">
                                        <option value="@editContractPaymentCopies[cp.Id].PaymentId">@GetPaymentLabel(cp.PaymentId)</option>
                                        @foreach (var p in AvailablePaymentsForContract(overlayContract))
                                        {
                                            <option value="@p.Id">@GetPaymentLabel(p.Id)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <div class="input-group">
                                        <input type="number" class="form-control" step="1" min="0" max="100" @bind="editContractPaymentCopies[cp.Id].ContractSharePercent" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </td>
                                <td>-</td>
                                <td><input type="date" class="form-control" @bind="editContractPaymentCopies[cp.Id].Start" /></td>
                                <td><input type="date" class="form-control" @bind="editContractPaymentCopies[cp.Id].End" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => SaveContractPayment(cp.Id, overlayContract)">Speichern</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => CancelEditContractPayment(cp.Id)">Abbrechen</button>
                                </td>
                            }
                            else
                            {
                                <td>@(cp.Payment?.Project?.Title ?? projects.FirstOrDefault(pr => pr.Id == cp.Payment?.ProjectId)?.Title ?? "-")</td>
                                <td>PM-@cp.PaymentId</td>
                                <td>@(cp.Payment?.Start.ToShortDateString() ?? "-") – @(cp.Payment?.End.ToShortDateString() ?? "-")</td>
                                <td>@(cp.Payment?.Amount.ToString("C") ?? "-")</td>
                                <td>@cp.ContractSharePercent%</td>
                                <td>@(cp.ContractSharePercent * overlayContract.Fte)%</td>
                                <td>@(cp.Start?.ToShortDateString() ?? "-")</td>
                                <td>@(cp.End?.ToShortDateString() ?? "-")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditContractPayment(cp)">Bearbeiten</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteContractPayment(cp.Id, overlayContract)">Entfernen</button>
                                </td>
                            }
                        </tr>
                    }
                    <tr>
                        <td colspan="4">
                        <select class="form-control" @bind="GetOrAddContractPaymentInput(overlayContract.Id).PaymentId">
                                <option value="0">-- auswählen --</option>
                                @foreach (var p in AvailablePaymentsForContract(overlayContract))
                                {
                                    <option value="@p.Id">@GetPaymentLabel(p.Id)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="input-group">
                                <input type="number" class="form-control" step="1" min="0" max="100" @bind="GetOrAddContractPaymentInput(overlayContract.Id).ContractShare" />
                                <span class="input-group-text">%</span>
                            </div>
                        </td>
                        <td></td>
                        <td><input type="date" class="form-control" @bind="GetOrAddContractPaymentInput(overlayContract.Id).Start" /></td>
                        <td><input type="date" class="form-control" @bind="GetOrAddContractPaymentInput(overlayContract.Id).End" /></td>
                        <td>
                            <button class="btn btn-sm btn-success" @onclick="() => AddContractPayment(overlayContract)">Hinzufügen</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        }
    </SubTableOverlay>
}

@code {
    [Parameter] public List<Contract> contracts { get; set; } = new();
    [Parameter] public List<Employee> employees { get; set; } = new();
    [Parameter] public int? FilterEmployeeId { get; set; }
    [Parameter] public bool ShowAddForm { get; set; } = true;
    [Parameter] public bool ShowContractPayments { get; set; } = false;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public List<Payment> payments { get; set; } = new();
    [Parameter] public List<Project> projects { get; set; } = new();
    [Parameter] public EventCallback<Contract> OnContractAdded { get; set; }
    [Parameter] public EventCallback<int> OnContractDeleted { get; set; }
    [Parameter] public EventCallback<Contract> OnContractUpdated { get; set; }
    [Parameter] public EventCallback<string> OnMessageChanged { get; set; }

    private Contract newContractInput = GetDefaultContractInput();

    private static Contract GetDefaultContractInput(int employeeId = 0)
    {
        return new Contract()
        {
            EmployeeId = employeeId,
            Start  = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
            End = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(24).AddDays(-1),
            FtePercent = 100m,
            Group  = EmployeeGroup.E13,
            Level = 1,
            EmployerBruttoAddition = 0.2800m,
            AnualPaymentAddition = 0.4647m,
            ExperienceMonth = 0
        };
    }

    private HashSet<int> editingContractIds = new();
    private Dictionary<int, Contract> editContractCopies = new();

    private Contract? overlayContract = null;
    private Dictionary<int, ContractPayment> contractPaymentInputs = new();
    private HashSet<int> editingContractPaymentIds = new();
    private Dictionary<int, ContractPayment> editContractPaymentCopies = new();

    protected override void OnInitialized()
    {
        newContractInput.EmployeeId = FilterEmployeeId ?? 0;
    }

    private List<Contract> GetFilteredContracts()
    {
        if (FilterEmployeeId.HasValue)
            return contracts.Where(c => c.EmployeeId == FilterEmployeeId.Value).OrderByDescending(c => c.Start).ToList();
        return contracts.OrderByDescending(c => c.Start).ToList();
    }

    private ContractPayment GetOrAddContractPaymentInput(int contractId)
    {
        if (!contractPaymentInputs.TryGetValue(contractId, out var input))
        {
            input = new ContractPayment();
            contractPaymentInputs[contractId] = input;
        }
        return input;
    }

    private IEnumerable<Payment> AvailablePaymentsForContract(Contract c)
    {
        var cGroup = c.Group;
        var assignedIds = c.ContractPayments?.Select(x => x.PaymentId).ToHashSet() ?? new HashSet<int>();
        return payments.Where(p => !assignedIds.Contains(p.Id) &&
            (p.DetecatedTo == null || (p.DetecatedTo == cGroup)));
    }

    private string GetPaymentLabel(int paymentId)
    {
        var p = payments.FirstOrDefault(x => x.Id == paymentId);
        if (p == null) return $"PM-{paymentId}";
        var projectTitle = p.Project?.Title ?? projects.FirstOrDefault(pr => pr.Id == p.ProjectId)?.Title ?? "-";
        return $"{projectTitle} | PM-{p.Id} | {p.Start.ToShortDateString()} – {p.End.ToShortDateString()} | {p.Amount:C}";
    }

    private void ShowContractOverlay(Contract c)
    {
        overlayContract = c;
        if (!contractPaymentInputs.ContainsKey(c.Id))
            contractPaymentInputs[c.Id] = new ContractPayment();
    }

    private void CloseContractOverlay()
    {
        overlayContract = null;
    }

    // --- Contract CRUD ---

    private void EditContract(Contract c)
    {
        editingContractIds.Add(c.Id);
        editContractCopies[c.Id] = new Contract
        {
            Id = c.Id,
            EmployeeId = c.EmployeeId,
            Start = c.Start,
            End = c.End,
            FtePercent = c.FtePercent,
            Group = c.Group,
            Level = c.Level,
            AnualPaymentAddition = c.AnualPaymentAddition,
            ExperienceMonth = c.ExperienceMonth,
            EmployerBruttoAddition = c.EmployerBruttoAddition
        };
    }

    private void CancelEditContract(int id)
    {
        editingContractIds.Remove(id);
        editContractCopies.Remove(id);
    }

    private async Task SaveContract(int id)
    {
        if (!editContractCopies.TryGetValue(id, out var copy)) return;
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.Contracts.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.Start = copy.Start;
                dbItem.End = copy.End;
                dbItem.FtePercent = copy.FtePercent;
                dbItem.Group = copy.Group;
                dbItem.Level = copy.Level;
                dbItem.AnualPaymentAddition = copy.AnualPaymentAddition;
                dbItem.ExperienceMonth = copy.ExperienceMonth;
                dbItem.EmployerBruttoAddition = copy.EmployerBruttoAddition;
                await db.SaveChangesAsync();

                var idx = contracts.FindIndex(x => x.Id == id);
                if (idx >= 0)
                {
                    contracts[idx].Start = dbItem.Start;
                    contracts[idx].End = dbItem.End;
                    contracts[idx].FtePercent = dbItem.FtePercent;
                    contracts[idx].Group = dbItem.Group;
                    contracts[idx].Level = dbItem.Level;
                    contracts[idx].AnualPaymentAddition = dbItem.AnualPaymentAddition;
                    contracts[idx].ExperienceMonth = dbItem.ExperienceMonth;
                    contracts[idx].EmployerBruttoAddition = dbItem.EmployerBruttoAddition;
                }
                await OnContractUpdated.InvokeAsync(dbItem);
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
        finally
        {
            CancelEditContract(id);
        }
    }

    private async Task AddContract()
    {
        var employeeId = FilterEmployeeId ?? newContractInput.EmployeeId;
        if (employeeId == 0)
        {
            await OnMessageChanged.InvokeAsync("Bitte einen Mitarbeiter auswählen.");
            return;
        }
        if (newContractInput.End < newContractInput.Start)
        {
            await OnMessageChanged.InvokeAsync("Ende darf nicht vor dem Start liegen.");
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            var toSave = new Contract
            {
                EmployeeId = employeeId,
                Group = newContractInput.Group,
                Level = newContractInput.Level,
                AnualPaymentAddition = newContractInput.AnualPaymentAddition,
                ExperienceMonth = newContractInput.ExperienceMonth,
                EmployerBruttoAddition = newContractInput.EmployerBruttoAddition,
                Start = newContractInput.Start,
                End = newContractInput.End,
                FtePercent = newContractInput.FtePercent
            };
            db.Contracts.Add(toSave);
            await db.SaveChangesAsync();

            var saved = await db.Contracts.Include(c => c.Employee).FirstOrDefaultAsync(c => c.Id == toSave.Id);
            if (saved != null)
            {
                saved.ContractPayments = new List<ContractPayment>();
                contracts.Insert(0, saved);
                await OnContractAdded.InvokeAsync(saved);
            }
            await OnMessageChanged.InvokeAsync("Vertrag gespeichert.");
            newContractInput = GetDefaultContractInput(FilterEmployeeId ?? 0);
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    private async Task DeleteContract(int id)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var item = await db.Contracts.FindAsync(id);
            if (item != null)
            {
                db.Contracts.Remove(item);
                await db.SaveChangesAsync();
                contracts.RemoveAll(c => c.Id == id);
                await OnContractDeleted.InvokeAsync(id);
                await OnMessageChanged.InvokeAsync("Vertrag gelöscht.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    // --- ContractPayments CRUD ---

    private void EditContractPayment(ContractPayment cp)
    {
        editingContractPaymentIds.Add(cp.Id);
        editContractPaymentCopies[cp.Id] = new ContractPayment
        {
            Id = cp.Id,
            ContractId = cp.ContractId,
            PaymentId = cp.PaymentId,
            ContractShare = cp.ContractShare,
            Start = cp.Start,
            End = cp.End
        };
    }

    private void CancelEditContractPayment(int id)
    {
        editingContractPaymentIds.Remove(id);
        editContractPaymentCopies.Remove(id);
    }

    private async Task SaveContractPayment(int id, Contract c)
    {
        if (!editContractPaymentCopies.TryGetValue(id, out var copy)) return;
        try
        {
            using var db = DbFactory.CreateDbContext();
            var dbItem = await db.ContractPayments.FindAsync(id);
            if (dbItem != null)
            {
                dbItem.ContractShare = copy.ContractShare;
                dbItem.Start = copy.Start;
                dbItem.End = copy.End;
                dbItem.PaymentId = copy.PaymentId;
                await db.SaveChangesAsync();

                var idx = c.ContractPayments?.FindIndex(x => x.Id == id) ?? -1;
                if (idx >= 0)
                {
                    c.ContractPayments![idx].ContractShare = dbItem.ContractShare;
                    c.ContractPayments![idx].Start = dbItem.Start;
                    c.ContractPayments![idx].End = dbItem.End;
                    c.ContractPayments![idx].PaymentId = dbItem.PaymentId;
                    var loaded = await db.ContractPayments.Include(x => x.Payment).ThenInclude(p => p!.Project).FirstOrDefaultAsync(x => x.Id == id);
                    if (loaded != null) c.ContractPayments![idx].Payment = loaded.Payment;
                }
                await OnMessageChanged.InvokeAsync("Projektmittel-Zuweisung gespeichert.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
        finally
        {
            CancelEditContractPayment(id);
        }
    }

    private async Task AddContractPayment(Contract c)
    {
        var input = GetOrAddContractPaymentInput(c.Id);
        if (input.PaymentId == 0)
        {
            await OnMessageChanged.InvokeAsync("Bitte ein Projektmittel auswählen.");
            return;
        }
        if (input.ContractShare < 0 || input.ContractShare > 100)
        {
            await OnMessageChanged.InvokeAsync("Anteil muss zwischen 0 und 100 liegen.");
            return;
        }
        try
        {
            using var db = DbFactory.CreateDbContext();
            var cp = new ContractPayment
            {
                ContractId = c.Id,
                PaymentId = input.PaymentId,
                ContractShare = input.ContractShare,
                Start = input.Start,
                End = input.End
            };
            db.Add(cp);
            await db.SaveChangesAsync();

            var loaded = await db.ContractPayments
                .Include(x => x.Payment)
                    .ThenInclude(p => p!.Project)
                .FirstOrDefaultAsync(x => x.Id == cp.Id);

            if (loaded != null)
            {
                c.ContractPayments ??= new List<ContractPayment>();
                c.ContractPayments.Add(loaded);
            }
            await OnMessageChanged.InvokeAsync("Projektmittel zugewiesen.");
            contractPaymentInputs[c.Id] = new ContractPayment();
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }

    private async Task DeleteContractPayment(int contractPaymentId, Contract c)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            var item = await db.ContractPayments.FindAsync(contractPaymentId);
            if (item != null)
            {
                db.ContractPayments.Remove(item);
                await db.SaveChangesAsync();
                c.ContractPayments?.RemoveAll(x => x.Id == contractPaymentId);
                await OnMessageChanged.InvokeAsync("Zuweisung entfernt.");
            }
        }
        catch (Exception ex)
        {
            await OnMessageChanged.InvokeAsync(ex.Message);
        }
    }
    private string GetGroupName(EmployeeGroup group)
    {
        var mem = typeof(EmployeeGroup).GetMember(group.ToString()).FirstOrDefault();
        if (mem != null)
        {
            var disp = mem.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                         .OfType<System.ComponentModel.DataAnnotations.DisplayAttribute>()
                         .FirstOrDefault();
            if (disp != null) return disp.Name ?? group.ToString();
        }
        return group.ToString();
    }
}